<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/tvWrongQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvWrongYourAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/college_medicine"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvWrongCorrectAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/college_economics"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnExplainWrong"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="💡 اشرح لي ليه الإجابة دي"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:background="@drawable/bg_button_rounded"
        android:paddingHorizontal="14dp" />

</LinearLayout>